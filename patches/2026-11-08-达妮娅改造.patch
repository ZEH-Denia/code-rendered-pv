+#!/usr/bin/env python3
+"""致谢卡（白字黑底极简版）——与成片同字族，去配色、去装饰。
+
+    python macos/make_thanks_card_bw.py
+"""
+from __future__ import annotations
+
+import os
+import sys
+
+from PIL import Image, ImageDraw
+
+sys.path.insert(0, "film/tui_pv_world_execute_20260926")
+os.environ.setdefault("TUI_PALETTE", "deepsea")
+import tuikit as tk
+
+W, H = 1280, 720
+MONO = lambda s: tk.font(tk.F_MONO, s)
+MONOB = lambda s: tk.font(tk.F_MONO_B, s)
+HEAD = lambda s: tk.font(tk.F_HEAD, s)
+CJK = lambda s: tk.font(tk.F_CJK, s)
+
+im = Image.new("RGB", (W, H), (0, 0, 0))
+d = ImageDraw.Draw(im)
+
+
+def center(y, text, font, fill, tracking=0):
+    if tracking:
+        text = (" " * tracking).join(list(text))
+    w = d.textlength(text, font=font)
+    d.text(((W - w) / 2, y), text, font=font, fill=fill)
+    return y
+
+
+# 小标
+center(196, "T H A N K S", MONO(18), (110, 110, 110))
+center(228, "致谢", CJK(22), (140, 140, 140))
+
+# 主名
+center(276, "MisakaZentai", MONOB(64), (240, 240, 240))
+
+# 仓库
+center(372, "github.com/MisakaZentai/world-execute-me-dsh-pv", MONO(19), (150, 150, 150))
+
+# 分隔线
+d.line([(W / 2 - 260, 424), (W / 2 + 260, 424)], fill=(58, 58, 58), width=1)
+
+# 许可与说明
+center(452, "code MIT    ·    art CC BY-NC-SA 4.0    ·    music Mili", MONO(15), (128, 128, 128))
+center(486, "原片的一切功劳属于作者。这一版是同人二次创作。", CJK(16), (168, 168, 168))
+
+# 页脚（中英混排：中文用 CJK 字体，英文用等宽）
+def center_mixed(y, parts):
+    widths = [d.textlength(t, font=f) for t, f, _ in parts]
+    x = (W - sum(widths)) / 2
+    for (t, f, c), w in zip(parts, widths):
+        d.text((x, y), t, font=f, fill=c)
+        x += w
+
+center_mixed(636, [("非官方同人作品", CJK(13), (86, 86, 86)),
+                   ("   ·   unofficial fan work", MONO(13), (86, 86, 86))])
+
+out = "/Users/zeh/Documents/视频制作/试片-粉发角色/致谢-MisakaZentai-白字黑底.png"
+im.save(out)
+big = im.resize((W * 3, H * 3), Image.Resampling.NEAREST)
+big.save(out.replace(".png", "-4K.png"))
+print("ok", im.size, big.size)
