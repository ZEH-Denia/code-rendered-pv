+#!/bin/zsh
+# 一键出片（macOS 复刻版）
+#
+#   ./run.sh            # 等价于 python build.py all
+#   ./run.sh check      # 只做环境检查
+#   ./run.sh pages      # 只重做网页截图
+#   ./run.sh render     # 只重渲染（复用已有截图）
+#   ./run.sh all --4k   # 另出 3840x2160
+set -euo pipefail
+cd "$(dirname "$0")"
+
+if [[ ! -f pv-env.sh ]]; then
+  echo "缺少 pv-env.sh（字体环境变量），先跑 ./setup-macos.sh" >&2
+  exit 1
+fi
+source ./pv-env.sh
+
+step="${1:-all}"
+shift || true
+
+echo "== step: $step =="
+echo "   mono   = $PV_F_MONO"
+echo "   mono_b = $PV_F_MONO_B"
+echo "   cjk    = $PV_F_CJK"
+echo "   sym    = $PV_F_SYM"
+echo "   song   = $(ffprobe -v error -show_entries format=duration -of default=nw=1:nk=1 input/song.mp3 2>/dev/null || echo MISSING) s"
+
+exec .venv/bin/python build.py "$step" "$@"
