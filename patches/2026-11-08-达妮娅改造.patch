new file mode 100755
index 0000000..f6f6bdc
--- /dev/null
+++ b/setup-macos.sh
@@ -0,0 +1,60 @@
+#!/bin/zsh
+# macOS 环境装配（幂等，可重复跑）
+#
+#   ./setup-macos.sh          # 装依赖 + 生成 pv-env.sh
+#   ./setup-macos.sh --fonts  # 只重装字体并刷新 pv-env.sh
+#
+# 需要：Homebrew（brew）、uv（或 brew install python@3.12）、Node 20+、ffmpeg。
+set -euo pipefail
+cd "$(dirname "$0")"
+
+need() { command -v "$1" >/dev/null 2>&1 || { echo "缺少 $1，请先安装" >&2; exit 1; }; }
+need brew
+need node
+need npm
+need ffmpeg
+need ffprobe
+
+if [[ "${1:-}" != "--fonts" ]]; then
+  echo "== Python 3.12 venv =="
+  if ! command -v uv >/dev/null 2>&1; then
+    echo "未找到 uv，尝试 brew install uv"
+    brew install uv
+  fi
+  [[ -d .venv ]] || uv venv --python 3.12 .venv
+  uv pip install --python .venv/bin/python -q pillow numpy
+  .venv/bin/python -V
+
+  echo "== Playwright =="
+  npm install --no-audit --no-fund
+  npx playwright install chromium
+fi
+
+echo "== 字体 =="
+# 等宽：JetBrains Mono（OFL）。需要 Consolas 的 0.55 em → 这个是 0.6 em，宽约 9%，见 docs/FONTS.md
+if [[ ! -f "$HOME/Library/Fonts/JetBrainsMono-Regular.ttf" ]]; then
+  HOMEBREW_NO_AUTO_UPDATE=1 brew install --cask font-jetbrains-mono
+fi
+
+cat > pv-env.sh <<'EOF'
+set -euo pipefail
+FONT_DIR="$HOME/Library/Fonts"
+ASSET_ROOT="/System/Library/AssetsV2/com_apple_MobileAsset_Font8"
+export PV_F_MONO="$(find "$FONT_DIR" -maxdepth 1 -type f -name 'JetBrainsMono-Regular.ttf' -print -quit)"
+export PV_F_MONO_B="$(find "$FONT_DIR" -maxdepth 1 -type f -name 'JetBrainsMono-Bold.ttf' -print -quit)"
+export PV_F_CJK="$(find "$ASSET_ROOT" -path '*/AssetData/PingFang.ttc' -print -quit)"
+export PV_F_SYM="/System/Library/Fonts/Supplemental/STIXTwoMath.otf"
+test -f "$PV_F_MONO"
+test -f "$PV_F_MONO_B"
+test -f "$PV_F_CJK"
+test -f "$PV_F_SYM"
+EOF
+
+source ./pv-env.sh
+echo "   mono   = $PV_F_MONO"
+echo "   mono_b = $PV_F_MONO_B"
+echo "   cjk    = $PV_F_CJK"
+echo "   sym    = $PV_F_SYM"
+
+echo
+echo "完成。下一步：把歌曲放进 input/song.mp3（见 README-MACOS.md），然后 ./run.sh"
